# Copy to a PRIVATE ignored env file. Use independently generated hex secrets
# (e.g. openssl rand -hex 32); do not reuse B2C credentials.
B2B_POSTGRES_PASSWORD=replace-with-generated-hex
B2B_DB_PASSWORD=replace-with-another-generated-hex
B2B_AUTH_SECRET=replace-with-an-independent-generated-secret
B2B_APP_ORIGIN=https://gym.example.test
B2B_HTTP_PORT=4204
B2B_NODE_ENV=production
# Maximum stored uploads per gym, in MiB. Media lives in a separate persistent volume.
B2B_MEDIA_QUOTA_MB=256
