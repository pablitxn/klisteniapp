{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "APP_ORIGIN",
        "HOST",
        "PORT",
        "KLISTENI_API_URL",
        "TRUSTED_CLIENT_IP_HEADER",
        "NODE_ENV",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "BILLING_MODE",
        "MP_ACCESS_TOKEN",
        "MP_WEBHOOK_SECRET",
        "MP_SANDBOX_PAYER_EMAIL",
        "MP_MONTHLY_AMOUNT",
        "MP_YEARLY_AMOUNT",
        "VITE_APP_MODE",
        "KLISTENI_PUBLIC_PROFILE_FILE",
        "B2B_DATABASE_URL",
        "B2B_AUTH_SECRET",
        "B2B_APP_ORIGIN",
        "B2B_PORT",
        "B2B_HOST",
        "B2B_DEMO_MODE",
        "B2B_MEDIA_ROOT",
        "B2B_MEDIA_QUOTA_MB",
        "B2B_GATEWAY_PORT"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "typecheck"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_UMAMI_SCRIPT_URL",
        "VITE_UMAMI_HOST_URL",
        "VITE_UMAMI_WEBSITE_ID",
        "VITE_UMAMI_ALLOWED_HOSTNAME",
        "VITE_APP_MODE",
        "KLISTENI_PUBLIC_PROFILE_FILE"
      ],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "@klisteniapp/api#test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL"
      ],
      "outputs": []
    },
    "@klisteniapp/b2b-api#test": {
      "cache": false,
      "passThroughEnv": [
        "B2B_TEST_DATABASE_URL"
      ],
      "outputs": []
    }
  }
}
