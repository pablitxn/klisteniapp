{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "APP_ORIGIN", "HOST", "PORT", "KLISTENI_API_URL", "TRUSTED_CLIENT_IP_HEADER", "NODE_ENV", "SMTP_HOST", "SMTP_PORT", "SMTP_SECURE", "SMTP_USER", "SMTP_PASSWORD", "SMTP_FROM"]
    },
    "build": {
      "dependsOn": [
        "^build",
        "typecheck"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_UMAMI_SCRIPT_URL",
        "VITE_UMAMI_HOST_URL",
        "VITE_UMAMI_WEBSITE_ID",
        "VITE_UMAMI_ALLOWED_HOSTNAME"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
