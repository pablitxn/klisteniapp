[
  [
    "docker",
    "network",
    "create",
    "klisteni-readiness-network-v1"
  ],
  [
    "docker",
    "run",
    "--pull=never",
    "-d",
    "--name",
    "klisteni-readiness-browser-v1",
    "--network",
    "klisteni-readiness-network-v1",
    "--init",
    "--user",
    "pwuser",
    "--security-opt",
    "no-new-privileges",
    "--security-opt",
    "seccomp=/workspace/.onboarding/browser-support/seccomp_profile.json",
    "--shm-size=1g",
    "--mount",
    "type=bind,src=/tmp/klisteni-readiness-runtime/app,dst=/task/app,readonly",
    "--mount",
    "type=bind,src=/tmp/b2b-integration-v13/browser-runtime,dst=/runtime,readonly",
    "--mount",
    "type=bind,src=/tmp/klisteni-readiness-runtime/evidence,dst=/tmp/readiness-evidence",
    "--workdir",
    "/task/app",
    "-e",
    "B2B_TEST_DATABASE_URL",
    "-e",
    "B2B_PRODUCT_TEST_ACTIVATE=1",
    "-e",
    "B2B_PRODUCT_USE_BUILT=1",
    "-e",
    "PLAYWRIGHT_BROWSERS_PATH=/runtime/browsers",
    "-e",
    "CI=1",
    "-e",
    "NO_PROXY=127.0.0.1,localhost,atlas.b2b.test,sur.b2b.test,alias.b2b.test,unknown.b2b.test",
    "-e",
    "no_proxy=127.0.0.1,localhost,atlas.b2b.test,sur.b2b.test,alias.b2b.test,unknown.b2b.test",
    "sha256:fb70e03db1c00327d2a5626fa6eea50ef9adc333e90c415b104722bb53df58d5",
    "node",
    "-e",
    "setInterval(() => {}, 60000)"
  ],
  [
    "docker",
    "run",
    "--pull=never",
    "-d",
    "--name",
    "klisteni-readiness-pg-v1",
    "--network",
    "container:klisteni-readiness-browser-v1",
    "--tmpfs",
    "/var/lib/postgresql/data:rw,size=768m",
    "-e",
    "POSTGRES_USER=readiness",
    "-e",
    "POSTGRES_DB=klisteni_b2b_readiness_test",
    "-e",
    "POSTGRES_PASSWORD",
    "sha256:79bd7c99e923138f136f8009d6bffa66e21e9d4fda5c0c561b00fc9c90cfe537",
    "-c",
    "listen_addresses=127.0.0.1"
  ],
  [
    "docker",
    "exec",
    "-e",
    "PGPASSWORD",
    "klisteni-readiness-pg-v1",
    "psql",
    "-h",
    "127.0.0.1",
    "-U",
    "readiness",
    "-d",
    "klisteni_b2b_readiness_test",
    "-Atc",
    "SELECT version()"
  ]
]
