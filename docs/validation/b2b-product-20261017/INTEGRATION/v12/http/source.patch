+async function assertUnboundContextDenied({ fixture, actor, port, path, headers }) {
+  const databaseUrl = new URL(source)
+  databaseUrl.searchParams.set('options', `-c search_path=${fixture.schema}`)
+  const db = createPool({ databaseUrl: databaseUrl.href })
+  let removed
+  try {
+    // Remove only this test actor's binding in the harness-owned disposable schema.
+    // Keep its authenticated session and membership intact to isolate realm denial.
+    const bindings = await db.query(
+      `SELECT c.* FROM b2b_session_context c JOIN b2b_auth_session s ON s.id=c.session_id
+       WHERE s."userId"=$1 AND c.organization_id='atlas-demo' AND c.domain_host='atlas.b2b.test'`,
+      [actor.id],
+    )
+    assert.equal(bindings.rows.length, 1)
+    const binding = bindings.rows[0]
+    const deleted = await db.query(
+      'DELETE FROM b2b_session_context WHERE session_id=$1 RETURNING *',
+      [binding.session_id],
+    )
+    removed = deleted.rows[0]
+    assert.equal(deleted.rowCount, 1)
+    for (const route of [
+      '/api/b2b/context',
+      '/api/b2b/bootstrap/v2',
+      '/api/b2b/orgs/atlas-demo/product/v2/access',
+    ]) {
+      const denied = await request(port, path(route), { headers })
+      assert.equal(denied.status, 401, `${route}: ${JSON.stringify(denied.body)}`)
+      assert.equal(denied.body.code, 'BRAND_SESSION_REQUIRED')
+    }
+  } finally {
+    try {
+      if (removed)
+        await db.query(
+          `INSERT INTO b2b_session_context(session_id,organization_id,domain_host,domain_generation,created_at)
+           VALUES($1,$2,$3,$4,$5)`,
+          [
+            removed.session_id,
+            removed.organization_id,
+            removed.domain_host,
+            removed.domain_generation,
+            removed.created_at,
+          ],
+        )
+    } finally {
+      await db.end()
+    }
+  }
+  const restored = await request(port, path('/api/b2b/context'), {
+    headers: { cookie: headers.cookie },
+  })
+  assert.equal(restored.status, 403, JSON.stringify(restored.body))
+  assert.equal(restored.body.code, 'CONTEXT_REVOKED')
+}
