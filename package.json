{
  "name": "klisteniapp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:accounts": "VITE_APP_MODE=instance turbo run dev --filter=@klisteniapp/web --filter=@klisteniapp/api",
    "build": "turbo run build",
    "lint": "pnpm check:b2b:boundaries && turbo run lint && pnpm format:b2b:check",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/preview-provenance.test.mjs scripts/b2b-boundaries.test.mjs scripts/dev-environment.test.mjs && turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm previews:check && pnpm build",
    "test:e2e": "pnpm --filter @klisteniapp/web test:e2e",
    "check:all": "pnpm check && pnpm test:e2e && pnpm test:analytics",
    "check:release": "node scripts/check-release.mjs",
    "equipment:check": "node scripts/validate-equipment.mjs",
    "previews:generate": "node scripts/generate-exercise-previews.mjs",
    "previews:check": "node scripts/generate-exercise-previews.mjs --check && pnpm body-previews:check && pnpm yoga-previews:check",
    "yoga-previews:generate": "node scripts/generate-yoga-previews.mjs",
    "yoga-previews:check": "node scripts/generate-yoga-previews.mjs --check",
    "body-previews:generate": "node scripts/generate-body-previews.mjs",
    "body-previews:check": "node scripts/generate-body-previews.mjs --check",
    "test:analytics": "pnpm --filter @klisteniapp/web exec playwright test --config playwright.analytics.config.ts",
    "test:api": "pnpm --filter @klisteniapp/api test",
    "test:accounts": "pnpm --filter @klisteniapp/web exec playwright test --config playwright.accounts.config.ts",
    "build:demo": "VITE_APP_MODE=demo turbo run build --filter=@klisteniapp/web",
    "build:instance": "VITE_APP_MODE=instance turbo run build --filter=@klisteniapp/web",
    "dev:instance": "VITE_APP_MODE=instance pnpm --filter @klisteniapp/web dev",
    "audit:publication": "node scripts/audit-publication.mjs",
    "dev:b2b": "node scripts/dev-b2b.mjs",
    "prepare:b2b": "node scripts/dev-b2b.mjs --prepare",
    "build:b2b": "pnpm --filter @klisteniapp/member-web build && pnpm --filter @klisteniapp/backoffice build",
    "test:b2b:api": "pnpm --filter @klisteniapp/b2b-api test",
    "test:b2b:e2e": "pnpm --filter @klisteniapp/web exec playwright test --config playwright.b2b.config.ts",
    "format:b2b": "prettier --config .prettierrc.b2b.json --write \"apps/b2b-api/{src,tests}/**/*.ts\" \"apps/{backoffice,member-web}/{src,tests}/**/*.{ts,tsx}\" \"packages/b2b-*/{src,tests}/**/*.{ts,tsx}\" \"scripts/{check-b2b-boundaries,b2b-boundaries.test}.mjs\"",
    "format:b2b:check": "prettier --config .prettierrc.b2b.json --check \"apps/b2b-api/{src,tests}/**/*.ts\" \"apps/{backoffice,member-web}/{src,tests}/**/*.{ts,tsx}\" \"packages/b2b-*/{src,tests}/**/*.{ts,tsx}\" \"scripts/{check-b2b-boundaries,b2b-boundaries.test}.mjs\"",
    "check:b2b:boundaries": "node scripts/check-b2b-boundaries.mjs",
    "dev:demo": "VITE_APP_MODE=demo pnpm --filter @klisteniapp/web dev",
    "setup:dev": "node scripts/dev-environment.mjs",
    "dev:gateway": "node scripts/b2b-gateway.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@klisteniapp/geometry": "workspace:*",
    "@klisteniapp/scene-schema": "workspace:*",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "3.6.2",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
