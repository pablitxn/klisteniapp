# OPTIONAL INSTANCE ONLY. Replace the /api fallback locations inside the server
# block of docker/nginx.conf with this file's contents. Adapt the upstream to
# your own private network and validate with nginx -t before starting.
# This example expects an API service named `api` on the same container network.
# It is never included by the default public demo image.
location = /api { default_type application/json; return 404 '{"error":"Not found"}'; }
location ^~ /api/ {
    client_max_body_size 5m;
    proxy_pass http://api:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    # Do not trust client-supplied forwarding or IP headers.
    proxy_set_header X-Klisteniapp-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header CF-Connecting-IP "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_hide_header Cache-Control;
    # The parent server inherits no-store for /api and security headers.
    # Do not map API errors to /index.html. This variant needs API DNS at startup;
    # an independent edge /api route avoids coupling the static server to it.
}
