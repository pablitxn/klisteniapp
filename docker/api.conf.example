# Optional accounts proxy, included inside the public Nginx server block.
# After API validation, replace the inline /api fallback locations in the
# deployment-provided nginx.conf with: include /etc/nginx/api.conf;
# Mount this completed file there. Copying it alone does not activate a proxy.
# The main nginx.conf must classify ^/api(?:/|$) as no-store in $cache_control.
# Set the resolver to the observed cluster DNS Service IP before promotion.
# This example uses a placeholder deliberately; it is not ready for nginx -t.
location = /api { return 404; }
location ^~ /api/ {
    resolver CLUSTER_DNS_SERVICE_IP valid=30s ipv6=off;
    set $klisteni_api "klisteniapp-api.klisteniapp-prod.svc.cluster.local:3001";
    client_max_body_size 5m;
    proxy_pass http://$klisteni_api$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    # Default API configuration derives client IP from its TCP peer. To enable
    # per-client limits behind this proxy, first configure trusted real_ip ingress
    # handling and set TRUSTED_CLIENT_IP_HEADER=x-klisteniapp-client-ip in the API.
    proxy_set_header X-Klisteniapp-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header CF-Connecting-IP "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_hide_header Cache-Control;
    # Cache-Control and security response headers inherit from the main server.
    # Do not configure error_page ... /index.html for this location.
}
