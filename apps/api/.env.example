# Copy to .env. Never commit real credentials. PostgreSQL is internal only.
DATABASE_URL=postgresql://klisteniapp:replace-me@localhost:5432/klisteniapp
# Generate a random secret with at least 32 characters. Keep stable across restarts.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Browser-facing origin, including port. Production requires https.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Default ignores incoming client-IP headers. Only enable behind a proxy that
# overwrites this header, and prevent direct access to the API port.
# TRUSTED_CLIENT_IP_HEADER=x-klisteniapp-client-ip

# Optional invitations/recovery mail. No SMTP connection is made until an
# administrator requests a link or someone submits public password recovery.
# STARTTLS is mandatory when SMTP_SECURE=false; certificate verification cannot be disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailbox@example.com
# SMTP_PASSWORD=replace-with-secret-manager-value
# SMTP_FROM=mailbox@example.com
