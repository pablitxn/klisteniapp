# OPTIONAL INSTANCE ONLY. The default demo needs none of these variables.
# Copy to apps/b2c-api/.env for a separately provisioned local API. Never commit it.
# Use your own database/role; do not point development or tests at a live service.
DATABASE_URL=postgresql://klisteni:replace-me@127.0.0.1:5432/klisteni
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
BILLING_MODE=disabled
# APP_ORIGIN must be the exact browser origin. Production requires HTTPS.
# Keep BETTER_AUTH_SECRET stable between restarts and replicas.
# TRUSTED_CLIENT_IP_HEADER is intentionally absent: only set it behind a proxy
# which overwrites the header and prevents direct access to the API port.

# SMTP is optional, server-only, and needs your own mailbox/relay.
# STARTTLS is mandatory for SMTP_SECURE=false; certificates must verify.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailbox@example.test
# SMTP_PASSWORD=replace-with-secret-manager-value
# SMTP_FROM=mailbox@example.test

# Mercado Pago is OFF. Separate provisioning and verification are required;
# this sample does not activate billing, OAuth or any health integration.
# A sandbox needs HTTPS APP_ORIGIN and your dedicated Argentina test seller/buyer.
# MP_ACCESS_TOKEN=replace-with-test-seller-token
# MP_WEBHOOK_SECRET=replace-with-provider-secret-at-least-32-characters
# MP_SANDBOX_PAYER_EMAIL=replace-with-test-buyer-email
# MP_MONTHLY_AMOUNT=
# MP_YEARLY_AMOUNT=
# See docs/subscriptions.md before opting in. No live payment mode is implemented.
