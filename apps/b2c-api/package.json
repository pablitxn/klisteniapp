{
  "name": "@klisteniapp/b2c-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch ../../scripts/dev-api.mjs b2c",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "users": "node --env-file-if-exists=.env src/operator.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "dev:prepare": "node ../../scripts/prepare-dev.ts b2c",
    "dev:configured": "node --watch --env-file-if-exists=.env src/server.ts"
  },
  "dependencies": {
    "@klisteniapp/scene-schema": "workspace:*",
    "better-auth": "1.7.7",
    "nodemailer": "10.0.13",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.5"
  }
}
