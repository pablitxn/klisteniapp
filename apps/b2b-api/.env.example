B2B_DATABASE_URL=postgres://b2b_runtime:replace-me@localhost:54330/klisteni_b2b_demo
B2B_MIGRATION_DATABASE_URL=postgres://b2b_migrator:replace-me@localhost:54330/klisteni_b2b_demo
B2B_AUTH_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
B2B_APP_ORIGIN=http://127.0.0.1:4200
B2B_MEDIA_ROOT=/var/lib/klisteni-b2b/media
B2B_MEDIA_QUOTA_MB=256
B2B_HOST=127.0.0.1
B2B_PORT=4201
B2B_DEMO_MODE=false
# Only for a dedicated synthetic demo database and local tests:
# B2B_DEMO_PASSWORD=choose-a-demo-only-password-at-least-12-characters
# B2B_TEST_DATABASE_URL=postgres://test_migrator:replace-me@localhost:54330/klisteni_b2b_test

# Enable only after registering and verifying brand domains. A multibranch DB rejects legacy mode.
B2B_WHITE_LABEL=false
# B2B_PROXY_SECRET=use-a-second-independent-random-secret-at-least-32-characters
# Exact proxy peers only; configure the static Nginx address for container deployments.
B2B_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
B2B_DOMAIN_PROTOCOL=https
# B2B_DOMAIN_EXPECTED_ADDRESSES=192.0.2.10
