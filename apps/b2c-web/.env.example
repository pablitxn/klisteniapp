# Default: complete static demo, local storage only, no account or analytics requests.
VITE_APP_MODE=demo

# Optional server instance (configure the operator and backend yourself):
# VITE_APP_MODE=instance
# KLISTENI_PUBLIC_PROFILE_FILE=/absolute/path/to/public-profile.json
# KLISTENI_API_URL=http://127.0.0.1:3001

# Public analytics configuration, only for an explicitly configured instance.
# Analytics still requires consent. Never put credentials in VITE_* variables.
# VITE_UMAMI_SCRIPT_URL=/umami/script.js
# VITE_UMAMI_HOST_URL=/umami
# VITE_UMAMI_WEBSITE_ID=replace-with-your-public-site-id
# VITE_UMAMI_ALLOWED_HOSTNAME=app.example.com
