{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "e2e",
    "playwright.config.ts",
    "playwright.analytics.config.ts",
    "playwright.accounts.config.ts",
    "playwright.visitor.config.ts",
    "playwright.health.config.ts",
    "playwright.demo.config.ts"
  ]
}
